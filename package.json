{
  "name": "qapp-core",
  "version": "1.0.80",
  "description": "Qortal's core React library with global state, UI components, and utilities",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-i18n": "node ./scripts/generate_locales.js",
    "build": "npm run build:types && npm run generate-i18n && tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "aes-js": "^3.1.2",
    "buffer": "^6.0.3",
    "compressorjs": "^1.3.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "dompurify": "3.4.13",
    "i18next": "^26.3.6",
    "idb-keyval": "^6.3.0",
    "iso-639-1": "^3.1.6",
    "react-dropzone": "^20.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-idle-timer": "^5.7.3",
    "react-intersection-observer": "^11.0.0",
    "react-rnd": "^10.5.3",
    "short-unique-id": "^5.3.2",
    "srt-webvtt": "^2.0.0",
    "ts-key-enum": "^3.0.13",
    "video.js": "^8.23.9",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.18",
    "@vitest/ui": "^4.1.10",
    "cpy-cli": "^7.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "20.11.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Qortal/qapp-core.git"
  },
  "keywords": [
    "qortal",
    "react",
    "zustand",
    "global state",
    "qapp"
  ],
  "author": "Your Name",
  "license": "MIT"
}
